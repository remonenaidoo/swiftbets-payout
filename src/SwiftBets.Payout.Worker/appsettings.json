{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "Environment": "dev",
    "ClientId": "swiftbets-payout"
  },
  "Jwt": {
    "Authority": "",
    "Audience": "swiftbets",
    "RequireHttpsMetadata": true
  },
  "Wallet": {
    "GrpcAddress": "",
    "DeadlineSeconds": 5
  },
  "ServiceIdentity": {
    "TokenEndpoint": "",
    "ClientId": "payout",
    "ClientSecret": ""
  },
  "Payout": {
    "Ladder": {
      "RungSeconds": [
        5,
        60,
        900
      ]
    }
  }
}
